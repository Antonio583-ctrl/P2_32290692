{
    "compilerOptions": {
      "target": "ES2020",
      "module": "CommonJS",
      "rootDir": "./src",
      "outDir": "./dist",
      "moduleResolution": "node",
      "strict": true,
      "esModuleInterop": true,
      "types": ["node"],
      "typeRoots": [
      "./src/types",
      "./node_modules/@types"
    ]
    },
    "include": ["src/**/*"]
  }
