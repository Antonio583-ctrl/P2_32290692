<% layout('layout-admin') %>
<h1>Pagos Realizados</h1>
<div class="admin-filtros">
  <input type="text" id="filtro-servicio" placeholder="Servicio">
  <input type="text" id="filtro-estado" placeholder="Estado">
  <input type="date" id="filtro-fecha-inicio">
  <input type="date" id="filtro-fecha-fin">
  <button onclick="filtrar()" style="padding:8px 18px; border-radius:6px; background:#3934db; color:#fff; border:none; font-weight:600;">Filtrar</button>
</div>
<table class="admin-table" id="tabla-pagos">
  <thead>
    <tr>
      <th>Servicio</th>
      <th>Monto</th>
      <th>Fecha</th>
      <th>Estado</th>
    </tr>
  </thead>
  <tbody>
    <% pagos.forEach(p => { %>
      <tr>
        <td><%= p.servicio || '' %></td>
        <td><%= p.monto %></td>
        <td><%= formatFecha(p.creado_en) %></td>
        <td><%= p.estado || 'completado' %></td>
      </tr>
    <% }) %>
  </tbody>
</table>
<script>
  function filtrar() {
    const servicio = document.getElementById('filtro-servicio').value.toLowerCase();
    const estado = document.getElementById('filtro-estado').value.toLowerCase();
    const fechaInicio = document.getElementById('filtro-fecha-inicio').value;
    const fechaFin = document.getElementById('filtro-fecha-fin').value;
    document.querySelectorAll('#tabla-pagos tbody tr').forEach(row => {
      const tdServicio = row.children[0].textContent.toLowerCase();
      const tdEstado = row.children[3].textContent.toLowerCase();
      const tdFecha = row.children[2].textContent.split('T')[0];
      let visible = true;
      if (servicio && !tdServicio.includes(servicio)) visible = false;
      if (estado && !tdEstado.includes(estado)) visible = false;
      if (fechaInicio && tdFecha < fechaInicio) visible = false;
      if (fechaFin && tdFecha > fechaFin) visible = false;
      row.style.display = visible ? '' : 'none';
    });
  }
</script>
