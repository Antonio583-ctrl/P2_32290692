
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Pagos Realizados</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    table { width: 100%; border-collapse: collapse; }
    th, td { border: 1px solid #ccc; padding: 8px; }
    th { background: #eee; }
    #filtro-servicio, #filtro-estado, #filtro-fecha-inicio, #filtro-fecha-fin { margin-right: 10px; }
  </style>
</head>
<body>
  <h1>Pagos Realizados</h1>
  <label>Servicio: <input type="text" id="filtro-servicio" placeholder="Servicio"></label>
  <label>Estado: <input type="text" id="filtro-estado" placeholder="Estado"></label>
  <label>Fecha inicio: <input type="date" id="filtro-fecha-inicio"></label>
  <label>Fecha fin: <input type="date" id="filtro-fecha-fin"></label>
  <button onclick="filtrar()">Filtrar</button>
  <table id="tabla-pagos">
    <thead>
      <tr>
        <th>Servicio</th>
        <th>Monto</th>
        <th>Fecha</th>
        <th>Estado</th>
      </tr>
    </thead>
    <tbody>
      <% pagos.forEach(p => { %>
        <tr>
          <td><%= p.servicio || '' %></td>
          <td><%= p.monto %></td>
          <td><%= p.creado_en %></td>
          <td><%= p.estado || 'completado' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <script>
    function filtrar() {
      const servicio = document.getElementById('filtro-servicio').value.toLowerCase();
      const estado = document.getElementById('filtro-estado').value.toLowerCase();
      const fechaInicio = document.getElementById('filtro-fecha-inicio').value;
      const fechaFin = document.getElementById('filtro-fecha-fin').value;
      document.querySelectorAll('#tabla-pagos tbody tr').forEach(row => {
        const tdServicio = row.children[0].textContent.toLowerCase();
        const tdEstado = row.children[3].textContent.toLowerCase();
        const tdFecha = row.children[2].textContent.split('T')[0];
        let visible = true;
        if (servicio && !tdServicio.includes(servicio)) visible = false;
        if (estado && !tdEstado.includes(estado)) visible = false;
        if (fechaInicio && tdFecha < fechaInicio) visible = false;
        if (fechaFin && tdFecha > fechaFin) visible = false;
        row.style.display = visible ? '' : 'none';
      });
    }
  </script>
</body>
</html>