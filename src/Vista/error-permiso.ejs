<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= t('access_denied.title') %></title>
  <style>
    body { font-family: Arial, sans-serif; background: #f8f8f8; text-align: center; padding: 60px; }
    .error-box { background: #fff; border-radius: 8px; display: inline-block; padding: 40px 60px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);}
    h1 { color: #c0392b; }
    p { color: #555; }
    a { color: #2980b9; text-decoration: none; }
  </style>
</head>
<body>
  <div class="error-box">
    <h1><%= t('access_denied.title') %></h1>
    <p><%= t('access_denied.message') %></p>
    <a href="/"><%= t('access_denied.back_link') %></a>
  </div>
</body>
</html>